# Same Supabase project the Flutter app uses — copy from docs/SUPABASE_SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# RLS-bypassing key, used server-side only (never sent to the browser).
# Same value as tools/migrate/.env's SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Comma-separated list of emails allowed to log in.
# After a magic-link sign-in, the middleware checks this list and signs the
# user out if their email isn't here.
ADMIN_EMAIL_ALLOWLIST=long.nh@newera.inc
