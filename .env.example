# Supabase project credentials for the Flutter app.
# Copy this file to `.env` and fill in real values from the Supabase dashboard
# (Settings → API). `.env` is gitignored.
#
# The `anon` key is safe to ship in the app — RLS policies in
# supabase/migrations/0002_rls.sql restrict it to read-only access on
# the wiki tables.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
